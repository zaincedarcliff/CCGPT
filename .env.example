# ──────────────────────────────────────────────────────────────────────────────
# CCGPT environment variables
# Copy to .env.local for local dev. In Vercel, add each under Project → Settings →
# Environment Variables. Only VITE_* values ship to the browser; everything else
# stays on the server.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server-side (SECRET) ─────────────────────────────────────────────────────
# Gemini key for answering + embeddings. REQUIRED.
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMS=768

# Web search provider — set ONE of these. Tavily is recommended (free tier, built for RAG,
# supports restricting to official domains). Auto-detected from whichever key is present.
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# WEB_SEARCH_PROVIDER=tavily        # force: tavily | brave | google
# If no search key is set, Gemini's built-in Google Search grounding is used as a fallback.
# GEMINI_GOOGLE_SEARCH_FALLBACK=true

# Persistent knowledge base storage (Vercel Blob). Created automatically when you add a Blob
# store to the project in Vercel (Storage → Blob). Without it, the index is written to ./.kb/.
BLOB_READ_WRITE_TOKEN=

# Secret used by the daily cron and for admin diagnostics (/api/kb-status?pages=1).
CRON_SECRET=

# Firebase project id for verifying user ID tokens on the server.
# Falls back to VITE_FIREBASE_PROJECT_ID, so this is optional if that is set.
# FIREBASE_PROJECT_ID=

# Optional: shared rate-limit store (recommended for production). Free tier at upstash.com.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_CHAT_PER_MINUTE=12
# RATE_CHAT_PER_DAY=300
# RATE_WEB_PER_MINUTE=6
# RATE_WEB_PER_DAY=120

# Optional crawler / retrieval tuning
# KB_MAX_PAGES=450                 # cap on pages tracked (seeds + discovered)
# KB_RUN_BUDGET_MS=240000          # per cron run fetch+embed budget
# KB_CONFIDENCE_THRESHOLD=0.58     # below this, web search runs
# KB_EXTRA_OFFICIAL_DOMAINS=       # comma-separated extra tier-1 hosts

# Local dev only: let /api/chat work without a signed-in Firebase user (never in production)
# ALLOW_ANON_CHAT=1
# CHAT_DEBUG=1                     # include retrieval decision + timings in /api/chat responses

# ── Client-side (public) ─────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_DISABLE_AI=1                # force the offline responder in the UI
#
# NOTE: VITE_GEMINI_API_KEY is no longer used by the browser. Remove it from Vercel and rotate
# the key — the old build shipped it in the client bundle.
